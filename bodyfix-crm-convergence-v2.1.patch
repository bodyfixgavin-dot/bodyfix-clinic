+"use client";
+import { FormEvent, useState } from "react";
+import { ClinicNotice, CrmShell, useClinicFetch } from "@/components/crm/CrmShell";
+type Data={city_sessions:any[]};
+export default function CitySessionsPage(){const{data,loading,error,reload}=useClinicFetch<Data>("/api/clinic/city-sessions");const[form,setForm]=useState({city_code:"yilan",session_name:"",session_status:"draft",start_date:"",end_date:"",internal_notes:""});async function submit(e:FormEvent){e.preventDefault();await fetch("/api/clinic/city-sessions",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(form)});setForm({...form,session_name:"",internal_notes:""});reload();}return <CrmShell title="城市場次管理" subtitle="建立與更新 draft / planning / registration_open / session_open / completed / cancelled。"><ClinicNotice loading={loading} error={error}/>{data&&<><section className="bf-notice bf-section-gap">如果 session_status 不是 session_open，公開前台不可顯示訂金欄位。後台可先填訂金規則供內部規劃。</section><section className="bf-card bf-section-gap"><h2 className="bf-section-title">新增 draft city session</h2><form className="bf-form clinic-form-grid" onSubmit={submit}><label>城市<input value={form.city_code} onChange={e=>setForm({...form,city_code:e.target.value})}/></label><label>場次名稱<input value={form.session_name} onChange={e=>setForm({...form,session_name:e.target.value})}/></label><label>狀態<select value={form.session_status} onChange={e=>setForm({...form,session_status:e.target.value})}>{["draft","planning","registration_open","session_open","completed","cancelled"].map(s=><option key={s} value={s}>{s}</option>)}</select></label><label>開始日期<input type="date" value={form.start_date} onChange={e=>setForm({...form,start_date:e.target.value})}/></label><label>結束日期<input type="date" value={form.end_date} onChange={e=>setForm({...form,end_date:e.target.value})}/></label><label className="clinic-wide">內部備註<textarea value={form.internal_notes} onChange={e=>setForm({...form,internal_notes:e.target.value})}/></label><button className="bf-primary" type="submit">新增 draft city session</button></form></section><section className="bf-card bf-section-gap bf-table-wrap"><table className="bf-admin-table"><thead><tr><th>城市</th><th>名稱</th><th>狀態</th><th>日期</th><th>確認/上限</th><th>預估收入</th><th>預估淨利</th><th>訂金設定</th><th>備註</th></tr></thead><tbody>{data.city_sessions.map(s=><tr key={s.id}><td>{s.city_code}</td><td>{s.session_name}</td><td>{s.session_status}</td><td>{s.start_date} - {s.end_date}</td><td>{s.confirmed_slots}/{s.max_slots}</td><td>NT${s.estimated_revenue}</td><td>NT${s.estimated_profit}</td><td>{s.deposit_required?`NT${s.deposit_amount} / ${s.deposit_deadline}`:"未啟用"}</td><td>{s.internal_notes}</td></tr>)}</tbody></table></section></>}</CrmShell>}

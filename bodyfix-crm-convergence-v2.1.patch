.target.value})}/></label><button className="bf-primary" type="submit">新增地區需求登記</button></form></section><section className="bf-card bf-section-gap bf-table-wrap"><table className="bf-admin-table"><thead><tr><th>登記時間</th><th>類型</th><th>城市</th><th>客戶來源區</th><th>偏好服務據點</th><th>名稱</th><th>聯絡方式</th><th>服務需求</th><th>主要問題</th><th>偏好時段</th><th>高意願</th><th>Grooming 興趣</th><th>培育狀態</th><th>備註</th></tr></thead><tbody>{data.leads.map(l=><tr key={l.id}><td>{l.created_at?.slice(0,10)}</td><td>{l.lead_type}</td><td>{l.city_code}</td><td>{l.client_area_code}</td><td>{l.preferred_zone_code}</td><td>{l.display_name}</td><td>{[l.line_id,l.instagram,l.phone].filter(Boolean).join(" / ")}</td><td>{l.service_interest}</td><td>{l.main_issue}</td><td>{l.preferred_time_type}</td><td>{l.high_intent?"是":"否"}</td><td>{l.grooming_interest?"是":"否"}</td><td>{l.nurture_status}</td><td>{l.notes}</td></tr>)}</tbody></table></section></>}</CrmShell>}
